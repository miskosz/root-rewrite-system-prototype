---
interface Props {
  code: string;
  height?: string;
}
const { code, height } = Astro.props;
---

<div
  class="rrs-embed not-prose"
  data-rrs-code={code}
  data-rrs-height={height}
>
  <div class="rrs-editor-mount"></div>
  <div class="rrs-controls"></div>
  <div class="rrs-status"></div>
  <div class="rrs-tree"></div>
</div>

<script>
  import { mountAll } from "../lib/embed/mount";
  mountAll();
</script>
