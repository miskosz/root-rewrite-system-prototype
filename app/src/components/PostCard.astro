---
interface Props {
  href: string;
  title: string;
  date: Date;
  summary: string;
}
const { href, title, date, summary } = Astro.props;
---
<a href={href} class="block border border-[var(--cupcake-base-300)] bg-[#fdfbfa] rounded-lg p-5 hover:border-[var(--cupcake-primary)] transition-colors no-underline">
  <h2 class="text-lg font-semibold text-[var(--cupcake-base-content)]">{title}</h2>
  <p class="text-sm text-[var(--cupcake-muted)] mt-1">
    {date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
  </p>
  <p class="text-[var(--cupcake-base-content)] mt-2">{summary}</p>
</a>
