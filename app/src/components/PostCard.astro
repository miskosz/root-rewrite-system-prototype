---
interface Props {
  href: string;
  title: string;
  date: Date;
  summary: string;
  author?: string;
}
const { href, title, date, summary, author } = Astro.props;
---
<a href={href} class="block border border-surface-3 bg-editor-bg rounded-lg p-5 hover:border-primary transition-colors no-underline">
  <h2 class="text-lg font-semibold text-ink">{title}</h2>
  <p class="text-sm text-muted mt-1">
    {date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
    {author && <> · {author}</>}
  </p>
  <p class="text-ink mt-2">{summary}</p>
</a>
