---
import "../styles/global.css";
interface Props { title: string; }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body class="antialiased">
  <header class="border-b border-[var(--cupcake-base-300)] bg-[var(--cupcake-base-200)]">
    <nav class="max-w-3xl mx-auto px-6 py-4 flex items-center gap-6">
      <a href={base} class="font-semibold text-[var(--cupcake-base-content)] no-underline">Root Rewrite Systems</a>
      <a href={base} class="text-sm text-[var(--cupcake-muted)] hover:text-[var(--cupcake-primary)]">Posts</a>
      <a href={`${base}playground`} class="text-sm text-[var(--cupcake-muted)] hover:text-[var(--cupcake-primary)]">Playground</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
</body>
</html>
