---
import "../styles/global.css";
interface Props { title: string; }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-theme="cupcake">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body class="bg-base-100 text-base-content antialiased min-h-screen">
  <header class="border-b border-base-300 bg-base-100">
    <nav class="max-w-3xl mx-auto px-6 py-4 flex items-center gap-6">
      <a href={base} class="font-semibold text-base-content no-underline">Root Rewrite Systems</a>
      <a href={base} class="text-sm opacity-70 hover:opacity-100 hover:text-primary">Posts</a>
      <a href={`${base}playground`} class="text-sm opacity-70 hover:opacity-100 hover:text-primary">Playground</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
</body>
</html>
