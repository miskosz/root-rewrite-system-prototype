---
import BaseLayout from "./BaseLayout.astro";
interface Props {
  title: string;
  date: Date;
  summary: string;
}
const { title, date, summary } = Astro.props;
---
<BaseLayout title={title}>
  <article class="max-w-3xl mx-auto px-6 py-10 prose prose-stone prose-lg prose-headings:scroll-mt-20 prose-headings:tracking-tight prose-a:text-[var(--cupcake-primary)] prose-a:no-underline hover:prose-a:underline prose-code:before:content-none prose-code:after:content-none prose-code:bg-[var(--cupcake-base-200)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-normal">
    <header class="not-prose mb-8">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--cupcake-base-content)]">{title}</h1>
      <p class="mt-2 text-sm text-[var(--cupcake-muted)]">
        {date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </p>
      <p class="mt-3 text-[var(--cupcake-base-content)]">{summary}</p>
    </header>
    <slot />
  </article>
</BaseLayout>
