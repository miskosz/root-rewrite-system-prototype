# BinNat
# List of binary digits, least significant first

### begin system ###

type List<'t>:
    Nil
    L(head: 't, tail: List<'t>)

open type CallType
open type ValueType

type Runtime(stack: List<CallType>)

@CallType
type Out(value: ValueType)

### end system ###

@ValueType
type Bit:
    B0
    B1

### sum

@CallType
type Sum(a: List<Bit>, b: List<Bit>)
@CallType
type SumImpl(a: List<Bit>, b: List<Bit>, carry: Bit, revdone: List<Bit>)
@CallType
type SumRev(rev: List<Bit>, front: List<Bit>)


rule Runtime(Sum(a, b) :: rt) -> Runtime(SumImpl(a, b, B0, Nil) :: rt)
rule Runtime(SumImpl(Nil, Nil, B0, revdone) :: rt) -> Runtime(
    SumRev(revdone, Nil) :: rt
)
rule Runtime(SumImpl(Nil, Nil, B1, revdone) :: rt) -> Runtime(
    SumRev(revdone, B1 :: Nil) :: rt
)
rule Runtime(SumImpl(a, Nil, carry, revdone) :: rt) -> Runtime(
    SumImpl(a, B0 :: Nil, carry, revdone) :: rt
)
rule Runtime(SumImpl(Nil, b, carry, revdone) :: rt) -> Runtime(
    SumImpl(B0 :: Nil, b, carry, revdone) :: rt
)
# a != Nil, b != Nil
# 0 + 0 + 0
rule Runtime(SumImpl(B0 :: at, B0 :: bt, B0, revdone) :: rt) -> Runtime(
    SumImpl(at, bt, B0, B0 :: revdone) :: rt
)
# 0 + 0 + 1
rule Runtime(SumImpl(B0 :: at, B0 :: bt, B1, revdone) :: rt) -> Runtime(
    SumImpl(at, bt, B0, B1 :: revdone) :: rt
)
rule Runtime(SumImpl(B0 :: at, B1 :: bt, B0, revdone) :: rt) -> Runtime(
    SumImpl(at, bt, B0, B1 :: revdone) :: rt
)
rule Runtime(SumImpl(B1 :: at, B0 :: bt, B0, revdone) :: rt) -> Runtime(
    SumImpl(at, bt, B0, B1 :: revdone) :: rt
)
# 0 + 1 + 1
rule Runtime(SumImpl(B0 :: at, B1 :: bt, B1, revdone) :: rt) -> Runtime(
    SumImpl(at, bt, B1, B0 :: revdone) :: rt
)
rule Runtime(SumImpl(B1 :: at, B0 :: bt, B1, revdone) :: rt) -> Runtime(
    SumImpl(at, bt, B1, B0 :: revdone) :: rt
)
rule Runtime(SumImpl(B1 :: at, B1 :: bt, B0, revdone) :: rt) -> Runtime(
    SumImpl(at, bt, B1, B0 :: revdone) :: rt
)
# 1 + 1 + 1
rule Runtime(SumImpl(B1 :: at, B1 :: bt, B1, revdone) :: rt) -> Runtime(
    SumImpl(at, bt, B1, B1 :: revdone) :: rt
)
# sumrev
rule Runtime(SumRev(Nil, front) :: rt) -> Runtime(Out(front) :: rt)
rule Runtime(SumRev(bit :: revtail, front) :: rt) -> Runtime(
    SumRev(revtail, bit :: front) :: rt
)

###

# 6 + 3
input Runtime(
    Sum(
        B0 :: B1 :: B1 :: Nil, B1 :: B1 :: Nil
    ) :: Nil
)

