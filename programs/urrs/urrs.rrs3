# URRS implementation

### begin system ###

type List<'t>:
    Nil
    L(head: 't, tail: List<'t>)

open type StackType

type Runtime(stack: List<StackType>)

### end system ###

type Nat:
    E
    S(Nat)

type Term:
    Var(Nat)
    Node(id: Nat, children: List<Term>)

type Bind(var: Var, term: Term)

type Rule(lhs: Term, rhs: Term)

# ---

### CopyNat ###

@StackType
type CopyNat(Nat)
@StackType
type CopyNatOut(Nat, Nat)
@StackType
type CopyNat2

rule Runtime(CopyNat(E) :: st) -> Runtime(CopyNatOut(E, E) :: st)
rule Runtime(CopyNat(S(a)) :: st) -> Runtime(CopyNat(a) :: CopyNat2 :: st)
rule Runtime(CopyNatOut(a1, a2) :: CopyNat2 :: st) -> Runtime(
    CopyNatOut(S(a1), S(a2)) :: st
)

### NatEq ###

@StackType
type NatEq(Nat, Nat)
@StackType
type NatEqOutFalse(Nat, Nat)
@StackType
type NatEqOutTrue(Nat, Nat)
@StackType
type NatEq2

rule Runtime(NatEq(E, E) :: st) -> Runtime(NatEqOutTrue(E, E) :: st)
rule Runtime(NatEq(S(a), S(b)) :: st) -> Runtime(
    NatEq(a, b) :: NatEq2 :: st
)
rule Runtime(NatEqOutFalse(a, b) :: NatEq2 :: st) -> Runtime(
    NatEqOutFalse(S(a), S(b)) :: st
)
rule Runtime(NatEqOutTrue(a, b) :: NatEq2 :: st) -> Runtime(
    NatEqOutTrue(S(a), S(b)) :: st
)
rule Runtime(NatEq(a, b) :: st) -> Runtime(NatEqOutFalse(a, b) :: st)

### CopyTerm ###

@StackType
type CopyTerm(t: Term)
@StackType
type CopyTermOut(t1: Term, t2: Term)
@StackType
type CopyTerm2
@StackType
type CopyTerm3(ch: List<Term>)
@StackType
type CopyTerm4(id1: Nat, id2: Nat)

# CopyTerm(Var(id))
rule Runtime(CopyTerm(Var(id)) :: st) -> Runtime(CopyNat(id) :: CopyTerm2 :: st)
rule Runtime(CopyNatOut(id1, id2) :: CopyTerm2 :: st) -> Runtime(
    CopyTermOut(Var(id1), Var(id2)) :: st
)
# CopyTerm(Node(id, ch))
rule Runtime(CopyTerm(Node(id, ch)) :: st) -> Runtime(
    CopyNat(id) :: CopyTerm3(ch) :: st
)
rule Runtime(CopyNatOut(id1, id2) :: CopyTerm3(ch) :: st) -> Runtime(
    CopyTerms(ch) :: CopyTerm4(id1, id2) :: st
)
rule Runtime(CopyTermsOut(ch1, ch2) :: CopyTerm4(id1, id2) :: st) -> Runtime(
    CopyTermOut(Node(id1, ch1), Node(id2, ch2)) :: st
)

### CopyTerms ###

@StackType
type CopyTerms(terms: List<Term>)
@StackType
type CopyTermsOut(terms1: List<Term>, terms2: List<Term>)
@StackType
type CopyTerms2(List<Term>)
@StackType
type CopyTerms3(Term, Term)

# CopyTerms(Nil)
rule Runtime(CopyTerms(Nil) :: st) -> Runtime(CopyTermsOut(Nil, Nil) :: st)
# CopyTerms(head :: tail)
rule Runtime(CopyTerms(head :: tail) :: st) -> Runtime(
    CopyTerm(head) :: CopyTerms2(tail) :: st
)
rule Runtime(CopyTermOut(h1, h2) :: CopyTerms2(tail) :: st) -> Runtime(
    CopyTerms(tail) :: CopyTerms3(h1, h2) :: st
)
rule Runtime(CopyTermsOut(t1, t2) :: CopyTerms3(h1, h2) :: st) -> Runtime(
    CopyTermsOut(h1 :: t1, h2 :: t2) :: st
)

# ---------------------
# ---------------------

# ### FindBind ###

@StackType
type FindBind(binds: List<Bind>, var: Var)
@StackType
type FindBindOutNoMatch(binds: List<Bind>, var: Var)
@StackType
type FindBindOutMatch(binds: List<Bind>, var: Var, match: Term)
@StackType
type FindBind2(Term, List<Bind>)
@StackType
type FindBind3(Nat, Term)

# FindBind(Nil, var)
rule Runtime(FindBind(Nil, var) :: st) -> Runtime(
    FindBindOutNoMatch(Nil, var) :: st
)
# FindBind(Bind(Var(id), term) :: btail, Var(id))
rule Runtime(
    FindBind(Bind(Var(id1), term) :: btail, Var(id2)) :: st
) -> Runtime(
    NatEq(id1, id2) :: FindBind2(term, btail) :: st
)
rule Runtime(
    NatEqOutTrue(id1_, id2) :: FindBind2(term, btail) :: st
) -> Runtime(
    FindBindOutMatch(btail, Var(id2), term) :: st
)
rule Runtime(
    NatEqOutFalse(id1, id2) :: FindBind2(term, btail) :: st
) -> Runtime(
    FindBind(btail, Var(id2)) :: FindBind3(id1, term) :: st
)
rule Runtime(
    FindBindOutMatch(btail, var, matched_term) :: FindBind3(id1, term) :: st
) -> Runtime(
    FindBindOutMatch(Bind(Var(id1), term) :: btail, var, matched_term) :: st
)
rule Runtime(
    FindBindOutNoMatch(btail, var) :: FindBind3(id1, term) :: st
) -> Runtime(
    FindBindOutNoMatch(Bind(Var(id1), term) :: btail, var) :: st
)

### Substitute ###

@StackType
type Substitute(binds: List<Bind>, varterm: Term)
@StackType
type SubstituteOut(unused_binds: List<Bind>, varterm: Term)
@StackType
type Substitute2
@StackType
type Substitute3(id: Nat)

# Substitute(binds, Var(id))
rule Runtime(Substitute(binds, Var(id)) :: st) -> Runtime(
    FindBind(binds, Var(id)) :: Substitute2 :: st
)
rule Runtime(
    FindBindOutNoMatch(binds, Var(id)) :: Substitute2 :: st
) -> Runtime(
    SubstituteOut(binds, Var(id)) :: st
)
rule Runtime(
    FindBindOutMatch(binds, Var(id), match) :: Substitute2 :: st
) -> Runtime(
    SubstituteOut(binds, match) :: st
)
# Substitute(binds, Node(id, ch))
rule Runtime(Substitute(binds, Node(id, ch)) :: st) -> Runtime(
    SubstituteMany(binds, ch) :: Substitute3(id) :: st
)
rule Runtime(
    SubstituteManyOut(binds, ch) :: Substitute3(id) :: st
) -> Runtime(
    SubstituteOut(binds, Node(id, ch)) :: st
)

### Substitute ###

@StackType
type SubstituteMany(binds: List<Bind>, terms: List<Term>)
@StackType
type SubstituteManyOut(unused_binds: List<Bind>, terms: List<Term>)
@StackType
type SubstituteMany2(List<Term>)
@StackType
type SubstituteMany3(Term)

# SubstituteMany(binds, Nil)
rule Runtime(SubstituteMany(binds, Nil) :: st) -> Runtime(
    SubstituteManyOut(binds, Nil) :: st
)
# SubstituteMany(binds, head :: tail)
rule Runtime(SubstituteMany(binds, head :: tail) :: st) -> Runtime(
    Substitute(binds, head) :: SubstituteMany2(tail) :: st
)
rule Runtime(
    SubstituteOut(binds, head) :: SubstituteMany2(tail) :: st
) -> Runtime(
    SubstituteMany(binds, tail) :: SubstituteMany3(head) :: st
)
rule Runtime(
    SubstituteManyOut(binds, tail) :: SubstituteMany3(head) :: st
) -> Runtime(
    SubstituteManyOut(binds, head :: tail) :: st
)

### ListMerge ###

@StackType
type ListMerge(List<Bind>, List<Bind>)
@StackType
type ListMergeOut(List<Bind>)

rule Runtime(ListMerge(Nil, l2) :: st) -> Runtime(ListMergeOut(l2) :: st)
rule Runtime(ListMerge(head :: tail, l2) :: st) -> Runtime(
    ListMerge(tail, head :: l2) :: st
)

