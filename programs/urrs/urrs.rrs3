# URRS
# Sum
# I0 - Zero
# I1 - Succ
# I2 - Program
input
    # Runtime(
    #     CopyTerm(
    #         Node(
    #             S(S(E)),
    #             Node(S(E), Var(E) :: Nil) :: Var(S(E)) :: Nil
    #         )
    #     ) :: Nil
    # )

    Runtime(
        Substitute(
            Bind(Var(S(S(E))), Node(E, Nil)) ::
            Bind(Var(S(E)), Node(S(E), Nil)) ::
            Bind(Var(E), Node(S(S(E)), Nil)) ::
                Nil,
            Node(
                E,
                Node(
                    S(E),
                    Var(S(S(E))) :: Node(E, Nil) :: Nil
                ) ::
                Var(S(E)) ::
                    Nil
            )
        ) :: Nil
    )

    # Runtime(
    #     RunRRS(
    #         # rules
    #         # Program(Succ(x), y) = Program(x, Succ(y))
    #         Rule(
    #             Node(
    #                 I2,
    #                 Node(I1, Var(I0) :: Nil) :: Var(I1) :: Nil
    #             ),
    #             Node(
    #                 I2,
    #                 Var(I0) :: Node(I1, Var(I1) :: Nil) :: Nil
    #             )
    #         ) :: Nil,
    
    #         # term
    #         # Program(Succ(Succ(Zero)), Succ(Zero))
    #         Node(
    #             I2,
    #             Node(
    #                 I1,
    #                 Node(
    #                     I1, Node(I0, Nil) :: Nil
    #                 ) :: Nil
    #             ) ::
    #             Node(
    #                 I1, Node(I0, Nil) :: Nil
    #             ) ::
    #             Nil
    #         )
    #     ) :: Nil,
    #     Nil  # vstack
    # )
