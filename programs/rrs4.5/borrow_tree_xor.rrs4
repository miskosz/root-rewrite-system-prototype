# RRS4.5 with trimmed down syntax.

###
### begin system
###

type List<T> {
    Nil;
    L(head: T, tail: List<T>);
}

open type StackType
type Runtime(stack: List<StackType>)

###
### end system
###

type Bit {
    B0;
    B1;
}

type Tree {
    Leaf(Bit);
    T(Tree, Tree);
}

fn Xor(Bit, Bit): Bit match {
    (B0, B0) -> B0;
    (B0, B1) -> B1;
    (B1, B0) -> B1;
    (B1, B1) -> B0;
}

fn BorrowTreeXor(Tree): (Tree, Bit) match {
    Leaf(b) -> (Leaf(b), b);
    T(left, right)
        -> BorrowTreeXor(left) match (left, lxor)
        -> BorrowTreeXor(right) match (right, rxor)
        -> Xor(lxor, rxor) match xor
        -> (T(left, right), xor);
}
